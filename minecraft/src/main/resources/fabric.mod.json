{
  "schemaVersion": 1,
  "id": "reconfig_platform",
  "name": "ReConfig Platform",
  "version": "${mod_version}",
  "description": "Access all your mod settings in one place, with a sleek and intuitive interface.",
  "authors": [
    "duv14",
    "Polyfrost (original UI source)"
  ],
  "contact": {
    "homepage": "https://duv14.com"
  },
  "license": "GPL-3.0-only",
  "environment": "client",
  "mixins": [
    "mixins.oneconfigv1.init.json",
    "mixins.oneconfigv1.json"
  ],
  "entrypoints": {
    "client": [
      "org.polyfrost.oneconfig.internal.OneConfig"
    ],
    "modmenu": [
      {
        "adapter": "kotlin",
        "value": "org.polyfrost.oneconfig.internal.compat.ModMenuEntrypoint"
      }
    ],
    "preLaunch": [
      "org.polyfrost.oneconfig.internal.SkikoDataPathPreLaunch"
    ]
  },
  "depends": {
    "fabricloader": ">=0.12.0",
    "minecraft": "${fabric_mc_version}",
    "fabric-api": "*"
  },
  "custom": {
    "modmenu": {
      "parent": "reconfig",
      "badges": [ "library" ]
    }
  }
}
